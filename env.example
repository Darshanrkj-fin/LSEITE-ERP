# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
APP_ENV=development
COMPANY_DEFAULT_STATE_CODE=

# GST notification checker (Phase 8) — surfaced via the header's
# notification bell, not email; see Layout.jsx.
GST_NOTIFICATION_SOURCE_URL=https://cbic-gst.gov.in/
CRON_SECRET=

# Email sending (Resend free tier) — used only for the "Email PDF" action
# on invoices (Phase 16). GST_ALERT_FROM_EMAIL is a generic default sender
# despite the name; defaults to Resend's own test sender if left blank —
# replace it once a sending domain is verified in your Resend account.
RESEND_API_KEY=
GST_ALERT_FROM_EMAIL=
